/* CREST TUI Styles */

/* ── App-wide ────────────────────────────────────────────────────────────── */
Screen {
    background: $surface;
}

.logo {
    color: $accent;
    text-align: center;
    padding: 1 2;
}

.screen-title {
    text-style: bold;
    color: $accent;
    padding: 0 2;
    margin-bottom: 1;
}

.section-label {
    text-style: bold;
    color: $text-muted;
    margin-top: 1;
}

/* ── Dashboard ───────────────────────────────────────────────────────────── */
#workflow-label {
    padding: 0 2;
}

#workflow-list {
    margin: 1 2;
    height: 1fr;
    border: solid $primary;
}

/* ── Two-panel layout ────────────────────────────────────────────────────── */
#main-layout {
    height: 1fr;
}

#form-panel {
    width: 50%;
    padding: 1 2;
    border-right: solid $primary-darken-2;
}

#preview-panel {
    width: 50%;
    padding: 1 2;
}

#preview-log {
    height: 1fr;
    border: solid $primary-darken-2;
}

/* ── Form elements ───────────────────────────────────────────────────────── */
Label {
    margin-top: 1;
    color: $text;
}

Input {
    margin-bottom: 0;
}

Select {
    margin-bottom: 0;
}

.button-row {
    margin-top: 2;
    height: auto;
}

.button-row Button {
    margin-right: 1;
}

/* ── Job Monitor ─────────────────────────────────────────────────────────── */
#status-bar {
    height: 3;
    padding: 0 2;
    background: $surface-darken-1;
    align: left middle;
}

#job-status {
    width: 1fr;
}

#job-timer {
    width: auto;
}

#output-log {
    height: 1fr;
    margin: 0 2;
    border: solid $primary-darken-2;
}

/* ── Settings ────────────────────────────────────────────────────────────── */
#settings-form {
    padding: 1 4;
    height: 1fr;
}

.status-msg {
    margin-top: 1;
    height: 2;
}

/* ── Widgets ─────────────────────────────────────────────────────────────── */
#atom-table {
    height: 1fr;
    border: solid $primary-darken-2;
}

#ensemble-table {
    height: 1fr;
    border: solid $primary-darken-2;
}

#constraint-table {
    height: 10;
    border: solid $primary-darken-2;
    margin-top: 1;
}

#constraint-toml {
    margin-top: 1;
    background: $surface-darken-1;
    padding: 1;
}

#energy-chart {
    padding: 1;
    background: $surface-darken-1;
}

/* ── Colours ─────────────────────────────────────────────────────────────── */
Button.success {
    background: $success;
}

Button.error {
    background: $error;
}
